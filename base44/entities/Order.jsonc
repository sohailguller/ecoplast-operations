{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order reference"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name for display"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "paid"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mpesa",
        "cash",
        "plastic_credit",
        "bank"
      ],
      "default": "mpesa"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "processing",
        "ready",
        "out_for_delivery",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "delivery_address": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "assigned_staff": {
      "type": "string",
      "description": "Staff handling delivery"
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "items",
    "total_amount"
  ]
}